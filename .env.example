# Copy this file to .env.local and fill in your values.

# Alchemy Starknet RPC key - used by the mainnet + sepolia providers in
# src/utils/constants.ts. Get one free at https://alchemy.com. The URL prefix is
# already set in constants.ts; paste ONLY the key here.
NEXT_PUBLIC_PROVIDER_URL=your_alchemy_key_here

# GhostDeal escrow (cairo/). Mainnet and Sepolia helpers are live.
NEXT_PUBLIC_GHOSTDEAL_ESCROW_MAINNET=0x1ad47d7b59f736383221af3847aeb737d358e0c2cce947482ca48dad6c4ca72
NEXT_PUBLIC_GHOSTDEAL_ESCROW_SEPOLIA=0x2fe8c2bc2194ccdf899c0566057217a34e139c0c5e6f7931f2b24cb436a22cf

# Optional Reown / WalletConnect project id for ReadyConnector (npm: ArgentMobile).
# Leave empty to use StarknetKit's default. Get one at https://cloud.reown.com
NEXT_PUBLIC_WC_PROJECT_ID=

# Required. Without these the dapp has no public marketplace.
# Upstash Redis REST: https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
