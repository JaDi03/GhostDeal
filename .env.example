# Copy this file to .env.local and fill in your values.

# Alchemy Starknet RPC key - used by the mainnet + sepolia providers in
# src/utils/constants.ts. Get one free at https://alchemy.com. The URL prefix is
# already set in constants.ts; paste ONLY the key here.
NEXT_PUBLIC_PROVIDER_URL=your_alchemy_key_here

# GhostDeal escrow (cairo/). 0x0 = not deployed. Paste the address after deploy.
NEXT_PUBLIC_GHOSTDEAL_ESCROW_MAINNET=0x0
NEXT_PUBLIC_GHOSTDEAL_ESCROW_SEPOLIA=0x0

# Optional Reown / WalletConnect project id for ReadyConnector (npm: ArgentMobile).
# Leave empty to use StarknetKit's default. Get one at https://cloud.reown.com
NEXT_PUBLIC_WC_PROJECT_ID=

# Shared marketplace storage (Upstash Redis REST, free tier:
# https://upstash.com - create a Redis db, copy URL + token). Server-side
# only. Without these the app runs local-only plus the demo seeds.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
